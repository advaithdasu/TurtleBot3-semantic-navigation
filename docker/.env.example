# Copy to docker/.env — compose reads it automatically from this directory.
# Nothing here is required; every value has a working default.

# JupyterLab token (http://localhost:8888/?token=...).
JUPYTER_TOKEN=tb3

# Host port for the noVNC desktop. Change it if something else on the GPU
# box already owns 6080 — the in-container port stays 6080 either way, so
# tunnel whatever you set here: ./docker/tunnel.sh -g 6081 user@gpu-host
GUI_PORT=6080

# Password for the noVNC desktop. Empty = no auth (fine behind the SSH
# tunnel, since the port is published on 127.0.0.1 only).
TB3_VNC_PASSWORD=

# `locate_anything` (real LocateAnything-3B, needs ~12 GB VRAM) or `mock`
# (GPU-free HSV colour heuristic, for exercising the pipeline).
GROUNDING_BACKEND=locate_anything

# HuggingFace read token. Only needed if the LocateAnything-3B download
# 401s/403s — the model is licence-gated, so accept its terms on the model
# page first, then paste a token here.
HF_TOKEN=
