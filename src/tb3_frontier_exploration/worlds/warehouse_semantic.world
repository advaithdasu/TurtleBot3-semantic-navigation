<?xml version="1.0" ?>
<!--
  warehouse_semantic.world — minimal gz-sim warehouse for TurtleBot3 + SLAM + Nav2 + fake semantic nav.

  Interior (open floor): approximately 4 m (X) × 6 m (Y), centered at origin.
  Semantic goals in map frame (see semantic_goals.yaml) assume map origin ≈ warehouse center (0, 0).

  Coordinate layout (top view, +X right, +Y up):
    Y = +3  ------ north wall ------
            |                       |
    X=-2    |   open interior       |    X=+2
            |                       |
    Y = -3  ------ south wall ------

  Inner faces: x = ±2, y = ±3. Safe approach poses: ≥1 m from each inner face
  ⇒ |x| ≤ 1, |y| ≤ 2 (see semantic_goals.yaml).
-->
<sdf version="1.6">
  <world name="warehouse_semantic">

    <!-- gz-sim system plugins. Gazebo Classic loaded physics, sensor
         rendering and GUI transport implicitly; gz-sim requires each to be
         declared per world. Without Sensors the camera and lidar publish
         nothing, without SceneBroadcaster the GUI shows an empty scene, and
         without UserCommands the `gz service .../set_pose` teleports that
         grounding/eval/capture_frames.py issues are silently dropped. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Standard lighting -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Infinite ground (collision + visual); warehouse walls provide boundaries -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physics: 1 ms steps, real time. The previous 2 ms / 500 Hz
         setting was a Rosetta concession; native arm64 has the CPU budget
         for upstream TurtleBot3's step size, which keeps the wheel
         contact solve stable. -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene ambient (subtle, works with sun) -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.75 0.8 1</background>
    </scene>

    <!--
      Walls: static boxes, thickness 0.2 m, height 2.5 m (good for lidar / collision).
      Inner clearance: X in [-2, 2], Y in [-3, 3] (4 m × 6 m).
    -->
    <model name="wall_east">
      <static>true</static>
      <pose>2.1 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 6.4 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 6.4 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-2.1 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 6.4 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 6.4 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.4 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4.4 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.6 0.62 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.4 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4.4 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.52 0.55 1</ambient>
            <diffuse>0.6 0.62 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Semantic props: cylinders at YAML approach poses (r=0.25 m) for LiDAR returns. z=center height. -->
    <model name="table">
      <static>true</static>
      <pose>0.7 1.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.55 0.4 0.28 1</ambient>
            <diffuse>0.65 0.48 0.32 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="chair">
      <static>true</static>
      <pose>-0.7 0.3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.35 0.45 0.65 1</ambient>
            <diffuse>0.42 0.52 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="fridge">
      <static>true</static>
      <pose>0.6 -1.4 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.75 0.76 0.8 1</ambient>
            <diffuse>0.88 0.9 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
